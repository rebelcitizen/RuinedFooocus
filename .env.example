# Copy to .env (ignored by git) to register this RuinedFooocus instance as a
# worker with a JobHub server. Environment variables with the same names win.
JOBHUB_URL=https://jobs.example.com
JOBHUB_TOKEN=jhw_replace_me
JOBHUB_WORKER_NAME=RuinedFooocus on my PC
# Set to 0 to keep the configuration but stay disconnected
JOBHUB_ENABLED=1
